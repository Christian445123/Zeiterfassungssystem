# Datenbank
DB_HOST=localhost
#DB_PORT=3306
DB_NAME=zeiterfassung
DB_USER=
DB_PASS=

# Allgemein
TIMEZONE=Europe/Vienna
APP_NAME=Zeiterfassung
TOKEN_LIFETIME_DAYS=30
# Urlaub: Wochen pro Jahr (Standard 5 = 25 Tage bei 5 Arbeitstagen)
#VACATION_WEEKS=5
# Eigene Eintragungen dürfen Mitarbeiter höchstens so viele Tage rückwirkend ändern (Standard 31)
#ENTRY_EDIT_DAYS=31
# Feiertage: AT (Österreich, Standard) oder NONE
#HOLIDAYS=AT
# 1 = Fehlerdetails im Browser anzeigen (nur zum Debuggen)
#APP_DEBUG=0

# Updates aus GitHub (Webpanel-Repository, Format Besitzer/Repository)
GITHUB_REPO=
GITHUB_BRANCH=main
# nur bei privatem Repository: Token mit Leserecht auf "Contents"
#GITHUB_TOKEN=
# Webhook: nach jedem Push aktualisiert sich das Panel automatisch (siehe deploy-webhook.php)
#DEPLOY_WEBHOOK_SECRET=


# Mobile App: neueste Version automatisch vom GitHub-Release des App-Repositories (Format Besitzer/Repository).
# Die App zeigt dann selbst "Neue Version verfügbar" mit Link zur APK. Leer = kein Hinweis.
APP_GITHUB_REPO=
# Optional (überschreiben die automatischen Werte): APP_MIN_VERSION = ältere Versionen müssen aktualisieren,
# APP_IOS_URL = TestFlight-/App-Store-Link für das iPhone (Apple kennt keinen GitHub-Download)
APP_MIN_VERSION=
APP_IOS_URL=
#APP_LATEST_VERSION=
#APP_ANDROID_URL=
