# Datenbank
DB_HOST=localhost
#DB_PORT=3306
DB_NAME=zeiterfassung
DB_USER=
DB_PASS=

# Allgemein
TIMEZONE=Europe/Vienna
APP_NAME=Zeiterfassung
TOKEN_LIFETIME_DAYS=30
# Urlaub: Wochen pro Jahr (Standard 5 = 25 Tage bei 5 Arbeitstagen)
#VACATION_WEEKS=5
# Eigene Eintragungen dürfen Mitarbeiter höchstens so viele Tage rückwirkend ändern (Standard 31)
#ENTRY_EDIT_DAYS=31
# Feiertage: AT (Österreich, Standard) oder NONE
#HOLIDAYS=AT
# 1 = Fehlerdetails im Browser anzeigen (nur zum Debuggen)
#APP_DEBUG=0

# Updates aus GitHub (Webpanel-Repository, Format Besitzer/Repository)
GITHUB_REPO=
GITHUB_BRANCH=main
# nur bei privatem Repository: Token mit Leserecht auf "Contents"
#GITHUB_TOKEN=
# Webhook: nach jedem Push aktualisiert sich das Panel automatisch (siehe deploy-webhook.php)
#DEPLOY_WEBHOOK_SECRET=


# Mobile App: neue Version ankündigen (die App zeigt dann "Update verfügbar")
# neueste Version, z. B. 1.2.0 (leer = kein Hinweis); MIN = ältere Versionen müssen aktualisieren
APP_LATEST_VERSION=
APP_MIN_VERSION=
# Download der Android-APK (z. B. GitHub-Release-Link) bzw. TestFlight-/App-Store-Link für iPhone
APP_ANDROID_URL=
APP_IOS_URL=
